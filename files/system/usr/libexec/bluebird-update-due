#!/usr/bin/env bash
# An update is due if the last successful update is older than the most recent Friday 23:00.
# BLUEBIRD_NOW (epoch seconds) and BLUEBIRD_STAMP are for testing only.
set -euo pipefail

STAMP="${BLUEBIRD_STAMP:-/var/lib/bluebird/last-update}"
[[ -f "$STAMP" ]] || exit 0   # no update recorded yet

now="${BLUEBIRD_NOW:-$(date +%s)}"
dow="$(date -d "@$now" +%u)"   # 1=Mon ... 5=Fri ... 7=Sun
back=$(( (dow - 5 + 7) % 7 ))
today="$(date -d "@$now" +%F)"

friday="$(date -d "$(date -d "$today -$back days" +%F) 23:00" +%s)"
if (( friday > now )); then    # it is Friday before 23:00: use the previous Friday
    friday="$(date -d "$(date -d "$today -$((back + 7)) days" +%F) 23:00" +%s)"
fi

last="$(stat -c %Y "$STAMP")"
if (( last < friday )); then
    exit 0
fi
exit 1